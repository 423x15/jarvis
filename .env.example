# Copier en .env et remplir

# Moteur LLM actif : mistral | anthropic | openai | ollama
# C'est le seul réglage à changer pour faire tourner Jarvis avec un autre
# modèle — cf. app/core/llm/factory.py
JARVIS_LLM_PROVIDER=mistral

# Renseigner uniquement la clé du provider choisi
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Pour un déploiement 100% local (aucune clé API, aucun réseau sortant)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Mémoire / RAG
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Skills
SKILLS_DIR=skills

# Observabilité (créer un compte gratuit sur cloud.langfuse.com ou self-host)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
JARVIS_ENV=dev
LOG_LEVEL=INFO
